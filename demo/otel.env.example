# ADOT -> CloudWatch / AgentCore Observability, for an agent hosted OUTSIDE AgentCore Runtime.
# cp demo/otel.env.example demo/otel.env, then adjust AGENT_NAME / region if needed.
# deploy/setup_observability.sh creates the log group + streams referenced here.
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1

# Identity of this agent. service.name is what online / batch evaluation filters on.
MINI_AGENT_NAME=text2sql-demo
OTEL_SERVICE_NAME=text2sql-demo
OTEL_RESOURCE_ATTRIBUTES=service.name=text2sql-demo,deployment.environment.name=demo,aws.log.group.names=/aws/bedrock-agentcore/runtimes/text2sql-demo

# ADOT GenAI pipeline + AWS configurator (SigV4 to the CloudWatch OTLP endpoints)
AGENT_OBSERVABILITY_ENABLED=true
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Keep prompts / tool payloads on the spans (ADOT >= 0.18) instead of splitting them out.
AWS_GENAI_CONTENT_EXTRACTION_OPT_OUT=true

# Logs + EMF metrics -> agent log group; spans -> same log group (unified, needs ADOT >= 0.18
# and the X-Ray resource policy that setup_observability.sh adds).
OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-aws-log-group=/aws/bedrock-agentcore/runtimes/text2sql-demo,x-aws-log-stream=runtime-logs,x-aws-metric-namespace=bedrock-agentcore
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-aws-log-group=/aws/bedrock-agentcore/runtimes/text2sql-demo,x-aws-log-stream=spans

# Only the agent's own GenAI spans matter for evaluation; skip noisy HTTP-server spans.
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=fastapi,starlette,asgi,urllib3,requests
